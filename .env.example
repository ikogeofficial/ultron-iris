# Key NAMES only. Real values go in Cloudflare Worker secrets, never in the repo.
# Set them with:  npx wrangler secret put NAME   (run inside the worker folder)

# OpenRouter keys (add as many as you have: OR_KEY_1, OR_KEY_2, ...)
OR_KEY_1=
OR_KEY_2=
OR_KEY_3=
OR_KEY_4=
OR_KEY_5=

# NVIDIA Nemotron keys (NVIDIA_KEY_1, NVIDIA_KEY_2, ...)
NVIDIA_KEY_1=
NVIDIA_KEY_2=

# Web search (used from build Step 4)
TAVILY_KEY=
EXA_KEY=

# Supabase (service role is a Worker secret ONLY)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=

# Google (client ID is public; the secret is a Worker secret ONLY)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
